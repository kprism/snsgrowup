DEBUG=True
SECRET_KEY=change-me
DATABASE_URL=postgresql://snsgrowup:snsgrowup@db:5432/snsgrowup
REDIS_URL=redis://redis:6379/0
ALLOWED_HOSTS=localhost,127.0.0.1,.githubpreview.dev,.app.github.dev

# OpenAI API 설정
# 실제 키는 .env에만 저장하고 GitHub에는 커밋하지 않는다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Meta for Developers 앱 공통 설정
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_GRAPH_VERSION=v24.0

# FACEBOOK_* 이름도 호환용으로 지원한다.
